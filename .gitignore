__pycache__/
*.pyc
.DS_Store
.env
# Зірка, а не точне імʼя: ловить і "правильний" .venv, і дублікати на кшталт
# ".venv 2", які лишає конфлікт синхронізації iCloud/Finder.
.venv*

# Транскрипти — первинні дані дослідження. У git не їдуть ніколи. Те саме
# правило дублікатів, що й для .venv* — тому зірка, а не точний шлях.
local/data*

# Простори містять ключі й доменну специфіку. У git — лише ті, що йдуть у
# деплой (питання й брендинг — не секрет) або служать референсом.
spaces/*
!spaces/example/
!spaces/travel/

# Кошик адмінки (видалені дослідження) — локальний стан, потенційно чутливі
# дані, у git не йде ніколи.
.trash/

.server*.pid
local/.server.log

local/models/

web/_shots/

# Службовий lock-файл сесії Claude Code — не проєктний код.
.claude/scheduled_tasks.lock
.vercel
.env*

# Встановлені скіли Claude Code, не повʼязані з продуктом (тут своя схема
# Postgres через psycopg2, без Neon) — особисте оточення розробника, не
# частина репозиторію.
.agents/
skills-lock.json
.claude/skills/neon
.claude/skills/neon-postgres
